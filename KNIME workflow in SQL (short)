WITH customer_summary AS (
    SELECT
        CustomerID,
        Country,
        SUM(Revenue) AS TotalRevenue,
        MIN(ContractDate) AS FirstPurchase
    FROM dbo.RWFD_sales_2008_2011
    GROUP BY
        CustomerID,
        Country
)

SELECT
    s.*,
    c.TotalRevenue,
    c.FirstPurchase
FROM dbo.RWFD_sales_2008_2011 AS s
INNER JOIN customer_summary AS c
    ON s.CustomerID = c.CustomerID
WHERE
       (c.Country = 'DE' AND c.TotalRevenue > 30000)
    OR (c.Country = 'AT' AND c.TotalRevenue < 10000)
    OR (c.Country = 'CH' AND c.TotalRevenue BETWEEN 10000 AND 20000)
ORDER BY
    s.CustomerID,
    s.ContractDate;
